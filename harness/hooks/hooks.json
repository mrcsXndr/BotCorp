{
  "description": "BotCorp harness hooks. Every script sources hooks/_guard.sh first, so a bot turns any of them off with bot.yaml harness.hooks_disable (-> BOT_DISABLED_HOOKS) and module-gated ones follow harness.modules (-> BOT_MODULES). No SubagentStop envelope writer (measured as pure cost); SubagentStart/Stop here only append one line each to the activity log.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/block-dialogs.sh\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/config-guard.sh\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Read|Glob|Grep|Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/vault-guard.sh\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/core-guard.sh\"", "timeout": 5 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"", "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-end.sh\"", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.sh\"", "timeout": 25, "statusMessage": "harness: inbound guard" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" precompact-extract - v2/precompact_extract.py --stdin", "timeout": 15 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" precompact-timeline - v2/precompact_timeline.py --stdin", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/memory-sync.sh\"", "timeout": 15, "statusMessage": "harness: memory sync" },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/play-sound.sh\"", "timeout": 5 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-debrief.sh\"", "timeout": 30 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" session-summarize - infra/session_summarize.py --quiet", "timeout": 10 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" cost-meter cost_meter v2/cost_meter.py --stdin", "timeout": 20 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-commit.sh\"", "timeout": 30 }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-failure.sh\"", "timeout": 10 }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "quota_auto_resume_fired|quota_auto_resume_stale|quota_auto_resume_disabled",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/notification.sh\"", "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent.sh\" start", "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/subagent.sh\" stop", "timeout": 5 }
        ]
      }
    ]
  }
}
