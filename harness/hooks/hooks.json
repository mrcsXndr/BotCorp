{
  "description": "BotCorp harness hooks, all in Claude Code's exec form (no shell). The tool guards are one node process, guard.mjs (pre / post). Every other hook starts through run.mjs, which applies bot.yaml harness.hooks_disable (-> BOT_DISABLED_HOOKS) and harness.modules (-> BOT_MODULES) BEFORE spawning bash, so a switched-off hook costs no bash start; the script's own _guard.sh applies the same gates again. No SubagentStop envelope writer (measured as pure cost); SubagentStart/Stop here only append one line each to the activity log.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode|Read|Glob|Grep|Bash|PowerShell|Monitor|mcp__.*|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs", "pre"], "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs", "post"], "timeout": 15 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "session-start", "-", "session-start.sh"], "timeout": 30 },
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "session-env", "-", "session-env.sh"], "timeout": 15 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "session-end", "-", "session-end.sh"], "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "user-prompt-submit", "-", "user-prompt-submit.sh"], "timeout": 25, "statusMessage": "harness: inbound guard" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "precompact-extract", "-", "py.sh", "precompact-extract", "-", "v2/precompact_extract.py", "--stdin"], "timeout": 15 },
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "precompact-timeline", "-", "py.sh", "precompact-timeline", "-", "v2/precompact_timeline.py", "--stdin"], "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "memory-sync", "memory_sync", "memory-sync.sh"], "timeout": 15, "statusMessage": "harness: memory sync" },
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "play-sound", "sound", "play-sound.sh"], "timeout": 15 },
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "session-summarize", "session_summarize", "py.sh", "session-summarize", "session_summarize", "infra/session_summarize.py", "--quiet"], "timeout": 15 },
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "cost-meter", "cost_meter", "py.sh", "cost-meter", "cost_meter", "v2/cost_meter.py", "--stdin"], "timeout": 20 },
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "auto-commit", "auto_commit", "auto-commit.mjs"], "timeout": 30 }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "stop-failure", "usage_resume", "stop-failure.sh"], "timeout": 15 }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "quota_auto_resume_fired|quota_auto_resume_stale|quota_auto_resume_disabled",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "notification", "usage_resume", "notification.sh"], "timeout": 15 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "subagent", "-", "subagent.sh", "start"], "timeout": 15 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "subagent", "-", "subagent.sh", "stop"], "timeout": 15 }
        ]
      }
    ]
  }
}
